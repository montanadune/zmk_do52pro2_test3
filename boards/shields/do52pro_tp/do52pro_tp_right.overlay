#include "do52pro_tp.dtsi"

&default_transform { col-offset = <6>; };

&kscan0 {
    col-gpios
        = <&pro_micro 6 GPIO_ACTIVE_HIGH>, <&pro_micro 5 GPIO_ACTIVE_HIGH>
        , <&pro_micro 4 GPIO_ACTIVE_HIGH>, <&pro_micro 2 GPIO_ACTIVE_HIGH>
        , <&pro_micro 0 GPIO_ACTIVE_HIGH>, <&pro_micro 1 GPIO_ACTIVE_HIGH>
        ;
};

#define MOUSE_PS2_DRIVER_UART
#define MOUSE_PS2_DT_PRESENT
#define MOUSE_PS2_PIN_SCL_PRO_MICRO <&pro_micro 15 GPIO_ACTIVE_HIGH>
#define MOUSE_PS2_PIN_SDA_PRO_MICRO <&pro_micro 16 GPIO_ACTIVE_HIGH>
#define MOUSE_PS2_PIN_SDA_PINCTRL <NRF_PSEL(UART_RX, 0, 10)>
#define MOUSE_PS2_UART_BAUD_RATE <14400>
#define MOUSE_PS2_PIN_UNEXPOSED_TX <NRF_PSEL(UART_TX, 0, 27)>
#define MOUSE_PS2_PIN_UNEXPOSED_RX <NRF_PSEL(UART_RX, 0, 28)>

// 割り込み優先度設定をまとめ、各種ペリフェラル定義を最小構成にスリム化
&gpiote { interrupts = <6 0>; };
// (中略: 各種割り込み定義は省略せず展開、または必要最小限に整理)
// ※詳細は提供元のデバイスツリー構造をご参照ください。

&pinctrl {
    uart0_ps2_default: uart0_ps2_default { group1 { psels = MOUSE_PS2_PIN_UNEXPOSED_TX, MOUSE_PS2_PIN_SDA_PINCTRL; }; };
    uart0_ps2_sleep: uart0_ps2_sleep { group1 { psels = MOUSE_PS2_PIN_UNEXPOSED_TX, MOUSE_PS2_PIN_SDA_PINCTRL; low-power-enable; }; };
    uart0_ps2_off: uart0_ps2_off { group1 { psels = MOUSE_PS2_PIN_UNEXPOSED_TX, MOUSE_PS2_PIN_UNEXPOSED_RX; }; };
};

&uart0 {
    status = "disabled";
    compatible = "nordic,nrf-uarte";
    current-speed = MOUSE_PS2_UART_BAUD_RATE;
    pinctrl-0 = <&uart0_ps2_default>;
    pinctrl-1 = <&uart0_ps2_off>;
    pinctrl-names = "default", "sleep";

    uart_ps2: uart_ps2 {
        status = "disabled";
        compatible = "uart-ps2";
        scl-gpios = MOUSE_PS2_PIN_SCL_PRO_MICRO;
        sda-gpios = MOUSE_PS2_PIN_SDA_PRO_MICRO;
    };
};

/ {
    mouse_ps2: mouse_ps2 {
        status = "disabled";
        compatible = "zmk,input-mouse-ps2";
        ps2-device = <&uart_ps2>;
    };

    mouse_ps2_input_listener: mouse_ps2_input_listener {
        status = "disabled";
        compatible = "zmk,input-listener-ps2";
        device = <&mouse_ps2>;
    };
};
